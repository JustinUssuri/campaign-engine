{
  "permissions": {
    "allow": [
      "Bash(campaign *)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [{"type": "command", "command": "campaign session-start", "timeout": 15}]
      },
      {
        "matcher": "resume|compact",
        "hooks": [{"type": "command", "command": "campaign session-start", "timeout": 15}]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [{"type": "command", "command": "campaign-hook provision", "timeout": 15}]
      }
    ],
    "Stop": [
      {
        "hooks": [{"type": "command", "command": "campaign-hook narrate", "timeout": 10}]
      }
    ]
  }
}
